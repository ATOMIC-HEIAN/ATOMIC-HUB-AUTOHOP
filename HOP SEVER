-- ================= LOGIC VALIDATION AUTO HOP =================
local isInputValid = true

local function validateInput()
    local val = tonumber(TargetInput.Text)
    local maxCap = Players.MaxPlayers
    
    if val and val > maxCap then
        isInputValid = false
        TargetInput.TextColor3 = COLOR_RED
        InputStroke.Color = COLOR_RED
        MaxPlayersLabel.Text = getTxt("errorLimit") .. maxCap .. ")"
        MaxPlayersLabel.TextColor3 = COLOR_RED
        HopButton.BackgroundColor3 = COLOR_DISABLED
        HopBtnStroke.Color = Color3.fromRGB(80, 80, 90)
        HopButton.TextColor3 = Color3.fromRGB(150, 150, 160)
    else
        isInputValid = true
        TargetInput.TextColor3 = COLOR_BLUE
        InputStroke.Color = COLOR_BLUE
        MaxPlayersLabel.Text = getTxt("maxInfo") .. maxCap .. getTxt("playersUnit")
        MaxPlayersLabel.TextColor3 = Color3.fromRGB(170, 170, 180)
        HopButton.BackgroundColor3 = COLOR_DARK_BLUE
        HopBtnStroke.Color = COLOR_BLUE
        HopButton.TextColor3 = COLOR_TEXT
    end
end

TargetInput:GetPropertyChangedSignal("Text"):Connect(validateInput)

