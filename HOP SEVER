-- ================= TÍNH NĂNG 2: TP TO PLAYER IN SERVER =================
local function SearchAndTpToPlayer(rawText)
    local targetName = rawText
    -- Nếu người dùng nhập dạng "name:abcxyz", lọc lấy phần tên phía sau dấu hai chấm
    if rawText:sub(1, 5):lower() == "name:" then
        targetName = rawText:sub(6)
    end
    targetName = targetName:gsub("^%s+", ""):gsub("%s+$", "") -- trim khoảng trắng

    if targetName == "" then return end

    MainCanvas.Visible = false
    StatusText.Visible = true
    StatusText.Text = getTxt("statusTP")

    local cursor = ""
    local targetServerId = nil

    while task.wait(0.3) do
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            local found = false
            for _, server in ipairs(result.data) do
                -- Lấy danh sách player preview nếu có trong server data (hoặc check qua API phụ nếu cần)
                -- Lưu ý: Roblox public servers API trả về danh sách player objects trong server.playerTokens / server.players
                if server.players then
                    for _, p in ipairs(server.players) do
                        if p.name and p.name:lower():find(targetName:lower()) then
                            targetServerId = server.id
                            found = true
                            break
                        end
                    end
                end
                if found then break end
            end

            if targetServerId then
                break
            end

            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            StatusText.Text = getTxt("statusRetry")
            task.wait(1)
        end
    end

    if targetServerId then
        StatusText.Text = getTxt("statusTPFound")
        TeleportService:TeleportToPlaceInstance(PlaceId, targetServerId, LocalPlayer)
    else
        StatusText.Text = getTxt("statusNotFound")
        task.wait(3)
        StatusText.Visible = false
        MainCanvas.Visible = true
    end
end

TpButton.MouseButton1Click:Connect(function()
    SearchAndTpToPlayer(PlayerInput.Text)
end)
