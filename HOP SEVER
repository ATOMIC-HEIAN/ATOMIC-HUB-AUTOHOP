-- ================= TÍNH NĂNG 1: AUTO HOP SERVER =================
local function HopToTargetServer(targetCount)
    if not isInputValid then return end

    if not targetCount or targetCount < 1 then
        targetCount = 1
        TargetInput.Text = "1"
    end

    MainCanvas.Visible = false
    StatusText.Visible = true
    StatusText.Text = getTxt("statusHop")
    
    local cursor = ""
    local foundServer = nil

    while task.wait(0.3) do
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.playing == targetCount and server.id ~= JobId then
                    foundServer = server.id
                    break
                end
            end

            if foundServer then
                break
            end

            if result.nextPageCursor then
                cursor = result.nextPageCursor
            else
                break
            end
        else
            StatusText.Text = getTxt("statusRetry")
            task.wait(1)
        end
    end

    if foundServer then
        StatusText.Text = getTxt("statusFound") .. targetCount .. getTxt("playersUnit") .. "!"
        TeleportService:TeleportToPlaceInstance(PlaceId, foundServer, LocalPlayer)
    else
        StatusText.Text = getTxt("statusNotFound")
        task.wait(3)
        StatusText.Visible = false
        MainCanvas.Visible = true
    end
end

