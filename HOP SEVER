-- ================= HỆ THỐNG CHỮ TRÊN ĐẦU NGƯỜI CHƠI (ADMIN VÀNG LẤP LÁNH ✨) =================
local function createAdminTitle(character)
    if not character then return end
    local head = character:WaitForChild("Head", 5)
    if not head then return end

    if head:FindFirstChild("AtomicAdminTag") then
        head.AtomicAdminTag:Destroy()
    end

    local bbGui = Instance.new("BillboardGui")
    bbGui.Name = "AtomicAdminTag"
    bbGui.Adornee = head
    bbGui.Size = UDim2.new(0, 300, 0, 70)
    bbGui.StudsOffset = Vector3.new(0, 3.0, 0)
    bbGui.AlwaysOnTop = true
    bbGui.Parent = head

    local mainContainer = Instance.new("Frame")
    mainContainer.Size = UDim2.new(1, 0, 1, 0)
    mainContainer.BackgroundTransparency = 1
    mainContainer.Parent = bbGui

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    listLayout.Padding = UDim.new(0, 2)
    listLayout.Parent = mainContainer

    local adminText = Instance.new("TextLabel")
    adminText.LayoutOrder = 1
    adminText.Size = UDim2.new(1, 0, 0, 26)
    adminText.BackgroundTransparency = 1
    adminText.Text = "✨ ADMIN ✨"
    adminText.TextColor3 = Color3.fromRGB(255, 215, 0)
    adminText.Font = Enum.Font.GothamBlack
    adminText.TextSize = 20
    adminText.TextStrokeTransparency = 0.2
    adminText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    adminText.Parent = mainContainer

    local nameText = Instance.new("TextLabel")
    nameText.LayoutOrder = 2
    nameText.Size = UDim2.new(1, 0, 0, 22)
    nameText.BackgroundTransparency = 1
    nameText.Text = "(@" .. LocalPlayer.Name .. ")"
    nameText.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameText.Font = Enum.Font.GothamBold
    nameText.TextSize = 15
    nameText.TextStrokeTransparency = 0.3
    nameText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameText.Parent = mainContainer

    local step = 0
    RunService.Heartbeat:Connect(function(dt)
        step = step + dt * 4
        local shine = (math.sin(step) + 1) / 2
        adminText.TextColor3 = Color3.fromRGB(255, 180 + (75 * shine), 30 * shine)
    end)
end

if LocalPlayer.Character then
