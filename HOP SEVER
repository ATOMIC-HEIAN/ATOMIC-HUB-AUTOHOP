-- LOGIC AUTO HOP (Tự hiện lại menu khi sang server mới)
local function HopServer(targetCount)
    FeatureCanvas.Visible = false
    StatusText.Visible = true
    StatusText.Text = getTxt("statusHop")
    
    local cursor = ""
    local foundServer = nil

    while task.wait(0.3) do
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.playing == targetCount and server.id ~= JobId then
                    foundServer = server.id
                    break
                end
            end
            if foundServer then break end
            if result.nextPageCursor then cursor = result.nextPageCursor else break end
        else
            StatusText.Text = getTxt("statusRetry")
            task.wait(1)
        end
    end

    if foundServer then
        StatusText.Text = getTxt("statusFound")
        TeleportService:TeleportToPlaceInstance(PlaceId, foundServer, LocalPlayer)
    else
        StatusText.Text = getTxt("statusNotFound")
        task.wait(3)
        StatusText.Visible = false
        FeatureCanvas.Visible = true
    end
end

-- LOGIC GLOBAL TP TO PLAYER
local function TpToGlobalPlayer(rawInput)
    local targetName = rawInput
    if rawInput:sub(1, 5):lower() == "name:" then targetName = rawInput:sub(6) end
    targetName = targetName:gsub("^%s+", ""):gsub("%s+$", "")

    if targetName == "" then return end

    FeatureCanvas.Visible = false
    StatusText.Visible = true
    StatusText.Text = getTxt("statusTP")

    local userId = nil
    pcall(function() userId = Players:GetUserIdFromNameAsync(targetName) end)

    if not userId then
        StatusText.Text = "❌ Không tìm thấy tên người chơi!"
        task.wait(3)
        StatusText.Visible = false
        FeatureCanvas.Visible = true
        return
    end

    local targetPlaceId, targetJobId = nil, nil
    local cursor = ""
    while task.wait(0.3) do
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.players then
                    for _, p in ipairs(server.players) do
                        if p.name and p.name:lower() == targetName:lower() then
                            targetPlaceId = PlaceId
                            targetJobId = server.id
                            break
                        end
                    end
                end
                if targetJobId then break end
            end
            if targetJobId then break end
            if result.nextPageCursor then cursor = result.nextPageCursor else break end
        else
            break
        end
    end

    if targetJobId then
        StatusText.Text = getTxt("statusTPFound")
        TeleportService:TeleportToPlaceInstance(targetPlaceId or PlaceId, targetJobId, LocalPlayer)
    else
        StatusText.Text = getTxt("statusNotFound")
        task.wait(3)
        StatusText.Visible = false
        FeatureCanvas.Visible = true
    end
end

ActionBtn.MouseButton1Click:Connect(function()
    if selectedMode == 1 then
        local num = tonumber(InputBox.Text) or 1
        HopServer(num)
    else
        TpToGlobalPlayer(InputBox.Text)
    end
end)
