ScrollLayout.Padding = UDim.new(0, 3)
Instance.new("UIPadding", ScrollList).PaddingTop = UDim.new(0, 3)

local selectedOutfitData = nil

local function refreshList()
    for _, child in ipairs(ScrollList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    if not _G.AtomicOutfitsMemory then return end
    for name, _ in pairs(_G.AtomicOutfitsMemory) do
        local btn = Instance.new("TextButton", ScrollList)
        btn.Size = UDim2.new(1, -6, 0, 24)
        btn.Position = UDim2.new(0, 3, 0, 0)
        btn.BackgroundColor3 = COLOR_BG
        btn.Text = "  📦 " .. name
        btn.TextColor3 = COLOR_TEXT
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 10
        btn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            selectedOutfitData = name
            for _, b in ipairs(ScrollList:GetChildren()) do
                if b:IsA("TextButton") then b.TextColor3 = COLOR_TEXT end
            end
            btn.TextColor3 = COLOR_BLUE
            StatusLabel.Text = "🎯 Chọn: " .. name
            StatusLabel.TextColor3 = COLOR_BLUE
        end)
    end
end

