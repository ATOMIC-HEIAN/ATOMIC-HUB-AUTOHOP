local FOLDER_NAME = "ATOMIC_HUB"
local FILE_NAME = FOLDER_NAME .. "/saved_catalog_outfits.json"
local savedAvatars = {}

pcall(function()
    if isfolder and not isfolder(FOLDER_NAME) and makefolder then makefolder(FOLDER_NAME) end
    if readfile and isfile and isfile(FILE_NAME) then
        savedAvatars = HttpService:JSONDecode(readfile(FILE_NAME)) or {}
    end
end)

local function saveToFile()
    pcall(function()
        if writefile then writefile(FILE_NAME, HttpService:JSONEncode(savedAvatars)) end
    end)
end

