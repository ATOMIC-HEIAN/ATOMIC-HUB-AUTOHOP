-- ================= HỆ THỐNG LƯU TRỮ VĨNH VIỄN (FILE SAVING) =================
local FOLDER_NAME = "ATOMIC_HUB"
local FILE_NAME = FOLDER_NAME .. "/saved_avatars.json"

local savedAvatars = {}

local function loadDataFromFile()
    pcall(function()
        if isfolder and not isfolder(FOLDER_NAME) and makefolder then
            makefolder(FOLDER_NAME)
        end
        if readfile and isfile and isfile(FILE_NAME) then
            local data = readfile(FILE_NAME)
            savedAvatars = HttpService:JSONDecode(data) or {}
        end
    end)
end

local function saveDataToFile()
    pcall(function()
        if isfolder and not isfolder(FOLDER_NAME) and makefolder then
            makefolder(FOLDER_NAME)
        end
        if writefile then
            writefile(FILE_NAME, HttpService:JSONEncode(savedAvatars))
        end
    end)
end

loadDataFromFile()

