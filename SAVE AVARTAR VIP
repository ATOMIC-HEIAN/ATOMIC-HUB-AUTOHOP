-- ================= LOGIC SAVE & LOAD AVATAR =================

SaveAvatarBtn.MouseButton1Click:Connect(function()
    local name = AvatarNameBox.Text
    if name == "" or name == "Tên Avatar (Bắt buộc)..." then
        AvatarNameBox.PlaceholderText = "❌ VUI LÒNG NHẬP TÊN CHUẨN!"
        task.wait(1.5)
        AvatarNameBox.PlaceholderText = "Tên Avatar (Bắt buộc)..."
        return
    end

    local char = LocalPlayer.Character
    if not char then return end

    -- Quét Humanoid Description
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local descSuccess, desc = pcall(function() return hum:GetAppliedDescription() end)
    
    if descSuccess and desc then
        -- Lưu dữ liệu Avatar
        savedAvatars[name] = {
            HatAccessory = desc.HatAccessory,
            FaceAccessory = desc.FaceAccessory,
            NeckAccessory = desc.NeckAccessory,
            ShoulderAccessory = desc.ShoulderAccessory,
            BackAccessory = desc.BackAccessory,
            WaistAccessory = desc.WaistAccessory,
            Shirt = desc.Shirt,
            Pants = desc.Pants,
            GraphicTShirt = desc.GraphicTShirt,
            Head = desc.Head,
            Face = desc.Face,
            Torso = desc.Torso,
            LeftArm = desc.LeftArm,
            RightArm = desc.RightArm,
            LeftLeg = desc.LeftLeg,
            RightLeg = desc.RightLeg,

            -- Save Animation Pack
            IdleAnimation = desc.IdleAnimation,
            WalkAnimation = desc.WalkAnimation,
            RunAnimation = desc.RunAnimation,
            JumpAnimation = desc.JumpAnimation,
            FallAnimation = desc.FallAnimation,
            ClimbAnimation = desc.ClimbAnimation,
            SwimAnimation = desc.SwimAnimation
        }

        saveDataToFile()
        refreshAvatarList()

        SaveAvatarBtn.Text = "✔️ ĐÃ LƯU THÀNH CÔNG!"
        task.wait(1.5)
        SaveAvatarBtn.Text = "💾 SAVE AVATAR (+ ANIMATION PACK)"
        AvatarNameBox.Text = ""
    end
end)

LoadAvatarBtn.MouseButton1Click:Connect(function()
    if not selectedAvatarData then
        LoadAvatarBtn.Text = "❌ CHƯA CHỌN AVATAR!"
        task.wait(1.5)
        LoadAvatarBtn.Text = "✨ LOAD AVATAR ĐÃ CHỌN"
        return
    end

    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    pcall(function()
        local newDesc = Instance.new("HumanoidDescription")
        
        for prop, val in pairs(selectedAvatarData) do
            pcall(function() newDesc[prop] = val end)
        end

        hum:ApplyDescription(newDesc)
        LoadAvatarBtn.Text = "⚡ DỊCH CHUYỂN OUTFIT BÁ KHÍ!"
        task.wait(1.5)
        LoadAvatarBtn.Text = "✨ LOAD AVATAR ĐÃ CHỌN"
    end)
end)

