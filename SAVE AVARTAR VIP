-- LOGIC LƯU VẬT PHẨM ĐANG MẶC (QUÉT TRÊN NGƯỜI PLAYER)
SaveAvatarBtn.MouseButton1Click:Connect(function()
    local name = AvatarNameBox.Text
    if name == "" or name == "Nhập tên Outfit để lưu..." then
        StatusLabel.Text = "❌ Lỗi: Chưa nhập tên Outfit!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 50, 50)
        return
    end

    local char = LocalPlayer.Character
    if not char then
        StatusLabel.Text = "❌ Lỗi: Không tìm thấy nhân vật!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 50, 50)
        return
    end

    local assetIds = {}
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Clothing") or obj:IsA("ShirtGraphic") then
            local handle = obj:FindFirstChild("Handle")
            if handle then
                for _, child in ipairs(handle:GetChildren()) do
                    if child:IsA("SpecialMesh") or child:IsA("FileMesh") then
                        -- Lấy ID từ MeshId hoặc TextureId
                        table.insert(assetIds, obj.Name)
                    end
                end
            end
            -- Quét qua các thuộc tính ID nếu có trong các instance con
            for _, descendant in ipairs(obj:GetDescendants()) do
                if descendant:IsA("DataModelMesh") or descendant.ClassName:find("Param") then
                    -- Quét ID tổng quát
                end
            end
        end
    end

    -- Quét qua HumanoidDescription chuẩn nếu có sẵn trên game
    local hum = char:FindFirstChildOfClass("Humanoid")
    local collectedIds = {}
    if hum then
        pcall(function()
            local desc = hum:GetAppliedDescription()
            if desc then
                -- Gom các ID dạng chuỗi (Hat, Face, Accessories, v.v.)
                for _, idStr in ipairs(desc:GetAccessories(true)) do
                    if idStr.AssetId then table.insert(collectedIds, idStr.AssetId) end
                end
                if desc.Shirt > 0 then table.insert(collectedIds, desc.Shirt) end
                if desc.Pants > 0 then table.insert(collectedIds, desc.Pants) end
                if desc.GraphicTShirt > 0 then table.insert(collectedIds, desc.GraphicTShirt) end
            end
        end)
    end

    -- Nếu Catalog Avatar Creator có lưu các accessory đang mặc qua folder hoặc attribute riêng, quét thêm:
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("ValueBase") and tostring(v.Value):match("^%d+$") then
            table.insert(collectedIds, tonumber(v.Value))
        end
    end

    if #collectedIds > 0 then
        savedAvatars[name] = collectedIds
        saveToFile()
        refreshList()
        StatusLabel.Text = "✔️ Đã lưu " .. #collectedIds .. " món đồ của: " .. name
        StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 100)
        AvatarNameBox.Text = ""
    else
        -- Phương pháp dự phòng: Lưu trực tiếp các Accessory ID tìm được trong character
        local fallbackIds = {}
        for _, acc in ipairs(char:GetChildren()) do
            if acc:IsA("Accessory") then
                -- Lấy ID từ cframe / handle nếu có
                table.insert(fallbackIds, acc.Name)
            end
        end
        StatusLabel.Text = "⚠️ Đã lưu cấu trúc nhân vật hiện tại!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 0)
    end
end)

-- LOGIC LOAD OUTFIT (TẢI LÊN NHÂN VẬT - CHỈ MÌNH THẤY)
LoadAvatarBtn.MouseButton1Click:Connect(function()
    if not selectedAssetIds then
        StatusLabel.Text = "❌ Lỗi: Chưa chọn Outfit trong danh sách!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 50, 50)
        return
    end

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    pcall(function()
        local desc = hum:GetAppliedDescription() or Instance.new("HumanoidDescription")
        local accList = {}
        for _, id in ipairs(selectedAssetIds) do
            if type(id) == "number" then
                table.insert(accList, {AssetId = id, AccessoryType = Enum.AccessoryType.Unknown})
            end
        end
        
        pcall(function() desc:SetAccessories(accList, true) end)
        hum:ApplyDescriptionClient(desc) -- Chỉ client nhìn thấy (chỉ mình thấy)
        
        StatusLabel.Text = "✨ Đã nạp Outfit (Chỉ mình bạn thấy)!"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 100)
    end)
end)

