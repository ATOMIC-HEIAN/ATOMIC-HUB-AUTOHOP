-- LOGIC SAVE
SaveAvatarBtn.MouseButton1Click:Connect(function()
    local name = AvatarNameBox.Text
    if name == "" or name == "Tên outfit..." then
        StatusLabel.Text = "❌ Chưa nhập tên!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 50, 50)
        return
    end

    local char = LocalPlayer.Character
    if not char then return end

    if not _G.AtomicOutfitsMemory then _G.AtomicOutfitsMemory = {} end
    _G.AtomicOutfitsMemory[name] = {}
    
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Clothing") or obj:IsA("ShirtGraphic") then
            pcall(function()
                table.insert(_G.AtomicOutfitsMemory[name], obj:Clone())
            end)
        end
    end

    refreshList()
    StatusLabel.Text = "✔️ Đã lưu: " .. name
    StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 100)
    AvatarNameBox.Text = ""
end)

-- LOGIC LOAD
LoadAvatarBtn.MouseButton1Click:Connect(function()
    if not selectedOutfitData or not _G.AtomicOutfitsMemory or not _G.AtomicOutfitsMemory[selectedOutfitData] then
        StatusLabel.Text = "❌ Chưa chọn outfit!"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 50, 50)
        return
    end

    local char = LocalPlayer.Character
    if not char then return end

    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Clothing") or obj:IsA("ShirtGraphic") then
            obj:Destroy()
        end
    end

    for _, item in ipairs(_G.AtomicOutfitsMemory[selectedOutfitData]) do
        pcall(function()
            item:Clone().Parent = char
        end)
    end

    StatusLabel.Text = "✨ Load thành công!"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 100)
end)

